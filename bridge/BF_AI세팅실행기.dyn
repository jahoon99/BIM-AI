      "Description": "실행할 AI 파이썬 스크립트(.py) 경로를 지정합니다."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import os\nimport traceback\nimport clr\n\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitAPIUI')\nclr.AddReference('RevitServices')\nimport Autodesk\nfrom Autodesk.Revit.DB import *\nfrom Autodesk.Revit.UI import *\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\n\ndoc = DocumentManager.Instance.CurrentDBDocument\nuiapp = DocumentManager.Instance.CurrentUIApplication\nuidoc = uiapp.ActiveUIDocument\n\nTransactionManager.Instance.ForceCloseTransaction()\n\nscript_path = IN[0]\n\nif not script_path or not os.path.exists(script_path):\n    OUT = '[대기 중] 실행할 스크립트 파일이 없습니다: {}'.format(script_path)\nelse:\n    try:\n        with open(script_path, 'r', encoding='utf-8-sig') as f:\n            ai_code = f.read()\n        exec_scope = globals().copy()\n        exec_scope['doc'] = doc\n        exec_scope['uiapp'] = uiapp\n        exec_scope['uidoc'] = uidoc\n        exec_scope['__revit__'] = uiapp\n        exec(ai_code, exec_scope)\n        res_msg = exec_scope.get('RESULT_MSG', '세팅 완료')\n        OUT = '[AI 자동 세팅 성공] {}'.format(res_msg)\n    except Exception as e:\n        OUT = '[실행 오류] {}\\n{}'.format(str(e), traceback.format_exc())",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "99999999888877776666555544443333",
