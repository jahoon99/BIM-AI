# 1. Google AI Studio에서 발급한 Gemini API 키 (Drive 서비스 계정 키와 별도)
GOOGLE_API_KEY="여기에_구글에서_발급받은_Gemini_API_키를_입력하세요"

# 2. 구글 API (Drive, Sheets) 서비스 계정 인증 파일 경로
# 다운로드 받은 서비스 계정 키(.json) 파일명을 적습니다.
GOOGLE_APPLICATION_CREDENTIALS="service_account_key.json"

# 3. 구글 드라이브 매뉴얼 폴더 ID
MANUAL_FOLDER_ID="여기에_매뉴얼_폴더_ID를_입력하세요"
BIM_FILE_FOLDER_ID="여기에_BIM_파일_폴더_ID를_입력하세요"

# 4. 메타데이터 RDB 역할을 할 구글 스프레드시트 고유 ID
# 시트 URL(https://docs.google.com/spreadsheets/d/[여기에_있는_값]/edit)에서 추출
SPREADSHEET_ID="여기에_스프레드시트_ID를_입력하세요"

# 5. 로컬 Vector DB (ChromaDB) 저장 경로
CHROMA_DB_PATH="./local_chroma_db"